# Check the simulator against tests/mcfr-regressions.yaml without the game.
#
# The manifest stays the data; this script is one of its readers. The other is
# scripts/refresh-regressions.mcscript, which re-records the same cases
# natively. This one only replays them through the simulator and compares the
# recorded tick count and physics hash, so it needs no game and no MCFR output.
#
#   mechcore run scripts/simulate-regressions.mcscript --check   validate offline
#   mechcore run scripts/simulate-regressions.mcscript           run the smoke tier
#
# Scope: smoke cases only, which is the tier the commit gate used to carry.
# Delete the `where` line to cover every case in the manifest instead; that is
# far longer, because the manifest holds 89 cases against 23 smoke ones.
#
# A case that no longer matches stops the run at that case and names the field,
# which is the drift check. Re-recording after an intended change is the other
# script's job; updating the table stays a deliberate, reviewable edit.

steps:
  - let:
      cases: read_yaml(tests/mcfr-regressions.yaml)

  - foreach: {case: $cases}
    where: {smoke: true}
    steps:
      - fight.run:
          layout: ${case.layout}
          seed: ${case.seed}
        expect:
          seed_source: external
          steps: ${case.tick_count}
          hashes.physics_result_hash: ${case.physics_result_hash}
