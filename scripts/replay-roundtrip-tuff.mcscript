# TUFF round 7: check native map-crystal preservation against the replay.
# Run with: cargo run --release run --force scripts/replay-roundtrip-tuff.mcscript
game: launch
vars:
  out: /Users/qbisi/mechcore-v2/work/research/tuff-map-selected-20260907
  grbr: /Users/qbisi/mechcore-v2/tests/grbr/2259_20260901--201562374_[crower]VS[[TUFF]MARLFAUX].grbr
steps:
  - record_replay_round:
      grbr: $grbr
      round: 7
      output: ${out}/replay-r7.mcfr
  - let:
      layout: embedded_layout(${out}/replay-r7.mcfr)
  - apply_layout: $layout
  - record_battle:
      output: ${out}/training-r7.mcfr
  - compare:
      left: ${out}/replay-r7.mcfr
      right: ${out}/training-r7.mcfr
