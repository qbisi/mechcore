# TUFF round 7: the roundtrip that tells the two fixed towers apart.
#
#   mechcore run scripts/replay-roundtrip-tuff.mcscript --check   validate offline
#   mechcore run scripts/replay-roundtrip-tuff.mcscript           record
#
# Red holds a level 2 Energy Tower beside an unstrengthened Research Center, so
# its `tower_strengthen_levels` is `[0, 2]` and reversing the two is visible in
# the fight. Every other tracked round is symmetric, which is why this one is
# the roundtrip that pins the keying: the capture reads the levels by
# `BuildingData.BuildingType` and writes each under its building-manager
# position, and `apply_layout` strengthens by that same position.
#
# The round also carries the native map crystals this replay played with, which
# is what the run first published here.
#
# The compare carries an expect, so a mismatch fails the run rather than being
# reported and passed over.
#
# Both paths must be absolute.

game: launch

vars:
  out: /Users/qbisi/mechcore-v2/work/research/tuff-tower-keying-20260911
  grbr: /Users/qbisi/mechcore-v2/tests/grbr/2259_20260901--201562374_[crower]VS[[TUFF]MARLFAUX].grbr

steps:
  - record_replay_round:
      grbr: $grbr
      round: 7
      output: ${out}/replay-r7.mcfr
  - let:
      layout: embedded_layout(${out}/replay-r7.mcfr)
  - apply_layout: $layout
  - record_battle:
      output: ${out}/training-r7.mcfr
  - compare:
      left: ${out}/replay-r7.mcfr
      right: ${out}/training-r7.mcfr
    expect:
      equal: true
      content_equal: true
