# Records the player's demo scene with the game, every unit's animated pose
# beside it, for scripts/player/pose-timing.py to read and
# scripts/player/model-views.py --recording to assemble the models from.
# At the game's own speed, because a view animates once per rendered frame:
# at the recording default of fifty times, poses would be read many ticks
# apart.
game: launch
headless: true
vars:
  out: /tmp/mechcore/player/record-poses
steps:
  - let:
      layout: read_yaml(crates/player/scenes/six-units.yaml)
  - game.apply_layout: {layout: $layout, seed: 7}
  - game.record: {output: $out/six-units.mcfr, speed_up: false, instrument: [unit_pose]}
