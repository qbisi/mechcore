# Record every round's native deployment state changes, including the opening.
# Each round has start/end records. round_jump skips combat via replay snapshots;
# its state difference is not a deployment action effect or observed combat.
# Read line by line through battle_end and summary; EOF alone is not completion.
# Edit the two variables for another recording; paths are relative to cwd.
# Run from the repository root:
#   mechcore run scripts/record-replay-battle.mcscript --check
#   mechcore run scripts/record-replay-battle.mcscript
# Requires the local macOS arm64 game, build 1.11.1.3.2259.
# The output must be new, even with --force; choose another path for a new run.

game: launch

vars:
  grbr: tests/grbr/2259_20260901--201562374_[crower]VS[[TUFF]MARLFAUX].grbr
  output: work/recordings/battle.jsonl

steps:
  - record_replay_battle:
      grbr: $grbr
      output: $output
