# Is a value added to the description in the number's own units?
#
#   mechcore run tests/modifier/value.mcscript --check   parse without the game
#   mechcore run tests/modifier/value.mcscript           record
#
# The rate clauses are measured: `tests/modifier/composition.mcscript` found
# enhancements summing, `tests/modifier/impairment.mcscript` found
# impairments compounding. This asks the remaining clause of
# `(base + Σ value) × (1 + Σ enhance) × Π (1 − impair)`.
#
# The build says what to expect. `DataSet.floatDatas` is a
# `List<AdditiveDataFloat>`, and that class's `Refresh` is a summing loop with
# `Min`/`Max` and `FPoint.Clamp` beside it. So a value is a sum in the
# number's own unit, and 20 means twenty metres of range rather than a
# proportion of anything.
#
# Extended Range Arclight is `+20` of range and `-0.2` of damage, so one
# recording carries a value and an impairment at once. An Arclight reaches 95
# metres and should reach 115, opening fire about twenty metres earlier and
# moving every tick after it — which is why the whole recording, not one
# number, is the reading. The control is the same fight with no officer.
#
# Both hashes below are the simulator's, computed before the recording
# existed.

game: launch

vars:
  out: /tmp/mechcore/modifier/value
  seed: 4242

steps:
  - let:
      none: read_yaml(tests/modifier/officer-range-none.yaml)
      ranged: read_yaml(tests/modifier/officer-range-value.yaml)

  - game.apply_layout:
      layout: $none
      seed: $seed
  - game.record_battle:
      output: ${out}/range-none.mcfr
    expect:
      operation.tick_count: 137
      operation.hashes.physics_result_hash: a796c1f3ffa43f9202d49f45d8150d6fb82f5a990127009775326fd7254d2f0e
  - fight.outcome:
      recording: ${out}/range-none.mcfr
    expect:
      sides.red.survivors.0.life: 16377

  - game.apply_layout:
      layout: $ranged
      seed: $seed
  - game.record_battle:
      output: ${out}/range-value.mcfr
    expect:
      operation.tick_count: 137
      operation.hashes.physics_result_hash: 46c4d1619e091a379f815c07a149ad0e079d96028eede7ebd2c0e1ab0379d29c
  - fight.outcome:
      recording: ${out}/range-value.mcfr
    expect:
      sides.red.survivors.0.life: 16961
  - fight.stats:
      recording: ${out}/range-value.mcfr
    expect:
      sides.blue.0.skill.0.modifiers.attack_range_value: 85899345920
      sides.blue.0.skill.0.modifiers.damage_rate.reduce: 858993459
      # 95 metres and 20 more, and 365 impaired by a fifth, as the build's own
      # properties answer them. Before the recording carried these, the value
      # had to be read off the whole fight.
      sides.blue.0.derived.attack_range: 493921239040
      sides.blue.0.derived.attack_damage: 292
