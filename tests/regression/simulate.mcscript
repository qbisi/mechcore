# Every native regression fight, fought again by the simulator.
#
#   mechcore run tests/regression/simulate.mcscript --check   validate without the game
#   mechcore run tests/regression/simulate.mcscript           run
#
# This needs no game, which is why CI runs it. Each file under `fights/` is a
# fight the game recorded, and `verify` holds the simulator to its tick count,
# its hash and every result it states. `refresh.mcscript` records the same
# fights again with the game and holds the game to them.
#
# The last step is not a recorded fight: it is a fight the game never
# recorded, pinned as the simulator plays it, and it says so where it stands.

steps:
  - let: {fights: glob(tests/regression/fights/*.yaml)}
  - verify: {input: $fights}
    expect: {invalid: []}

  # One fight the game never recorded, pinned as the simulator plays it. When
  # sampled RVO movement was modelled, its 321 ticks were reviewed by hand —
  # blue's Rhino beats both Arclights, and at tick 151 both Arclights' shots
  # land in one tick — and this holds the simulator to that reviewed run. The
  # hash is the simulator's own, not the game's, so a change that moves it has
  # to say why the new run is the right one.
  - convert:
      input: tests/regression/rhino-vs-two-arclights.yaml
      to: mcfr
      seed: 1787634176
    expect:
      steps: 321
      winner: blue
      hashes.result_hash: 47f2be55830719a24542f76b1cf8c720f43e45afdb8b881fb4cf392784ecc41a
