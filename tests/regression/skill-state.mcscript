# Which state is each unit's skill in, tick by tick, across the manifest?
#
#   mechcore run tests/regression/skill-state.mcscript --check   parse without the game
#   mechcore run tests/regression/skill-state.mcscript           record
#
# Re-records every case of tests/regression/mcfr-regressions.yaml with the
# `target_refs` instrument channel, which holds, per unit and tick,
# the main skill's `SkillStateController` state, its `SkillAttackController`
# phase, and its lock and attack target. It is the oracle the simulator's
# attack state is held to while it is being made a mirror of the build's:
# a recording shows where a unit goes and whom it hits, the channel shows the
# state that decided it. Across the manifest the kernel's states match it on
# 99% of unit-ticks; `docs/spec/simulation/architecture.md` says what is left.
#
# Every case, not only the smoke tier: a state that differs on one fight is
# the point. The channel is research evidence, outside both hashes.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/regression/skill-state

steps:
  - let:
      cases: read_yaml(tests/regression/mcfr-regressions.yaml)

  - foreach: {case: $cases}
    steps:
      - let:
          layout: read_yaml(${case.layout})
      - game.record_layout:
          layout: $layout
          seed: ${case.seed}
          output: ${out}/${case.name}.mcfr
          instrument: [target_refs]
