# Which state is each unit's skill in, tick by tick, across the regression fights?
#
#   mechcore run tests/regression/skill-state.mcscript --check   parse without the game
#   mechcore run tests/regression/skill-state.mcscript           record
#
# Records every fight under `fights/` again with the `target_refs` instrument
# channel, which holds, per unit and tick, the main skill's
# `SkillStateController` state, its `SkillAttackController` phase, and its
# lock and attack target. It is the oracle the simulator's attack state is
# held to while it is being made a mirror of the build's: a recording shows
# where a unit goes and whom it hits, the channel shows the state that
# decided it. Across these fights the kernel's states match it on 99% of
# unit-ticks; `docs/spec/simulation/architecture.md` says what is left.
#
# Every fight: a state that differs on one fight is the point. The channel is
# research evidence, outside the hash. Each recording lands under `out` at
# its fixture's own path.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/regression/skill-state

steps:
  - let: {fights: glob(tests/regression/fights/*.yaml)}

  - foreach: {fight: $fights}
    steps:
      - convert:
          to: mcfr
          backend: game
          input: $fight
          output: $out/${fight}.mcfr
          instrument: [target_refs]
