# Record every native regression fight again, and hold the game to it.
#
#   mechcore run tests/regression/refresh.mcscript --check   validate without the game
#   mechcore run tests/regression/refresh.mcscript           record and compare
#
# Each fight under `fights/` is recorded from its own layout and seed, the
# recording is read back as a fight document, and that document has to state
# exactly what the fixture states: the same ticks, the same hash, the same
# result. `simulate.mcscript` holds the simulator to the same files; this
# holds the game to them, so a build that changed a fight shows here first.
#
# The run stops at the first fight that differs, and what the game recorded
# is left beside it under `out`, at the fixture's own path. Nothing here
# writes a fixture back: replacing one with what a new recording says is a
# deliberate, reviewable edit, and a pin that moves is a finding to explain.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/regression/refresh

steps:
  - let: {fights: glob(tests/regression/fights/*.yaml)}

  - foreach: {fight: $fights}
    steps:
      - convert:
          to: mcfr
          backend: game
          input: $fight
          output: $out/${fight}.mcfr
      - convert:
          input: $out/${fight}.mcfr
          to: fight
          output: $out/$fight
      - diff:
          left: $fight
          right: $out/$fight
        expect:
          equal: true
