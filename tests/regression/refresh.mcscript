# Re-record the native regression samples in tests/regression/mcfr-regressions.yaml.
#
# The manifest stays the data; this script is one of its two readers. The other
# is tests/regression/simulate.mcscript, which replays the same table through
# the simulator offline. Nothing here writes the manifest back: a refresh
# produces values, and updating the table is a deliberate, reviewable edit.
#
#   mechcore run tests/regression/refresh.mcscript --check   validate offline
#   mechcore run tests/regression/refresh.mcscript           record
#
# Scope: smoke cases only, which is what battle.rs treats as the native tier.
# Delete the `where` line to cover every case in the manifest instead; that is
# far longer, because each case records a full battle.
#
# To verify rather than refresh, add an expect block to record_battle:
#
#     expect:
#       operation.tick_count: ${case.tick_count}
#       operation.hashes.physics_result_hash: ${case.physics_result_hash}
#
# With it the run stops at the first case that no longer matches, which is the
# drift check. Without it every case is recorded and reported, which is what
# produces new values after an intended change.

game: launch

vars:
  out: /tmp/mechcore/regression/refresh

steps:
  - let:
      cases: read_yaml(tests/regression/mcfr-regressions.yaml)

  - foreach: {case: $cases}
    where: {smoke: true}
    steps:
      - let:
          layout: read_yaml(${case.layout})
      - game.apply_layout:
          layout: $layout
          seed: ${case.seed}
      - game.record_battle:
          output: $out/${case.name}.mcfr
