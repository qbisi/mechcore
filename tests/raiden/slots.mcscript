# How do a Raiden's three grouped weapons choose their targets and fire?
#
#   mechcore run tests/raiden/slots.mcscript --check   parse without the game
#   mechcore run tests/raiden/slots.mcscript           record
#
# A Raiden's core is a fusillade `SkillGroup`: three `FightSkill`s, one per
# weapon, held to the core by `GroupedSkillFusilladeBehaviour`. The
# `skill_attackable_checker` channel records every `Check` call with the slot
# that made it and the slot's lock before and after it; `group_slots` records
# each slot's lock, attack target and state on every tick. Each fight is
# recorded once with both channels.
#
#   fang-in-reach  three Raidens with a Fang formation already in reach: nine
#                  blows on the first volley, each Raiden after the one before
#                  it has killed what it held
#   m1 .. m6       the Raiden's standard fights, both standard seeds: slots
#                  allocated a tower when no unit is left to them, a core
#                  taking a unit a sibling holds, and siblings cooling
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/raiden/slots

steps:
  - let:
      recordings:
        - {name: fang-in-reach-4242, layout: tests/raiden/fang-in-reach.yaml, seed: 4242}
        - {name: m1-mirror-4242, layout: tests/units/raiden/m1-mirror.yaml, seed: 4242}
        - {name: m1-mirror-1787720817, layout: tests/units/raiden/m1-mirror.yaml, seed: 1787720817}
        - {name: m2-rhino-4242, layout: tests/units/raiden/m2-rhino.yaml, seed: 4242}
        - {name: m2-rhino-1787720817, layout: tests/units/raiden/m2-rhino.yaml, seed: 1787720817}
        - {name: m3-crawler-4242, layout: tests/units/raiden/m3-crawler.yaml, seed: 4242}
        - {name: m3-crawler-1787720817, layout: tests/units/raiden/m3-crawler.yaml, seed: 1787720817}
        - {name: m4-marksman-4242, layout: tests/units/raiden/m4-marksman.yaml, seed: 4242}
        - {name: m4-marksman-1787720817, layout: tests/units/raiden/m4-marksman.yaml, seed: 1787720817}
        - {name: m5-rotated-4242, layout: tests/units/raiden/m5-rotated.yaml, seed: 4242}
        - {name: m5-rotated-1787720817, layout: tests/units/raiden/m5-rotated.yaml, seed: 1787720817}
        - {name: m6-formations-4242, layout: tests/units/raiden/m6-formations.yaml, seed: 4242}
        - {name: m6-formations-1787720817, layout: tests/units/raiden/m6-formations.yaml, seed: 1787720817}

  - foreach: {recording: $recordings}
    steps:
      - let:
          layout: read_yaml(${recording.layout})
      - game.record:
          input: $layout
          seed: ${recording.seed}
          output: ${out}/${recording.name}.mcfr
          instrument: [skill_attackable_checker, group_slots]
