# Every tower-loss fixture, replayed through the simulator.
#
#   mechcore run tests/tower/regressions.mcscript
#
# This needs no game. The hashes are what the game recorded with
# `levels.mcscript` and `both.mcscript`, seed 4242, and the simulator
# reproduces each fight tick for tick, in every field, from the layout and
# the seed alone. `README.md` says what each fight separates.

steps:
  # Level 0: the loss writes buff 1, 180 ticks; the tower has 3400 life.
  - fight.run:
      layout: tests/tower/tower-level-0.yaml
      seed: 4242
    expect:
      steps: 870
      hashes.result_hash: 380d721bf2aa581622f521e4386160a0b5eedfb16ffed7b477b7e288c31534ef
  # Level 1: 23400 life, buff 2, 140 ticks.
  - fight.run:
      layout: tests/tower/tower-level-1.yaml
      seed: 4242
    expect:
      steps: 925
      hashes.result_hash: 0c322396fa3a49b031760c50b21fd04c511f85b5152719d616f9bc00ae169bd4
  # Level 2: 59400 life, buff 3, 100 ticks.
  - fight.run:
      layout: tests/tower/tower-level-2.yaml
      seed: 4242
    expect:
      steps: 928
      hashes.result_hash: 9cbe8fedcb637c051d984abd8f497dfd0a10feea2d655b645fd2825a60463d66
  # Level 3: 131400 life, buff 4, 60 ticks.
  - fight.run:
      layout: tests/tower/tower-level-3.yaml
      seed: 4242
    expect:
      steps: 964
      hashes.result_hash: 4f36aa35d78f73aa3d69def0f1364305d3692289a26a99e96a59604b6b948cb3
  # Level 4: 235400 life, buff 5, 20 ticks.
  - fight.run:
      layout: tests/tower/tower-level-4.yaml
      seed: 4242
    expect:
      steps: 959
      hashes.result_hash: 0b355797b24b297bbab7d63b9c3236a241a5837c48078e5a5cfe1dd86fc04705
  # A second level-0 loss inside the first: the debuff lasts 180 ticks longer.
  - fight.run:
      layout: tests/tower/both-towers-0-0.yaml
      seed: 4242
    expect:
      steps: 581
      hashes.result_hash: cd73fdc16bc6af905c810fa8e02ab3179377c8b039856c3a51937e47262460e6
  # A level-4 loss inside a level-0 one: 180 + 20, gone at tick 431.
  - fight.run:
      layout: tests/tower/both-towers-0-4.yaml
      seed: 4242
    expect:
      steps: 641
      hashes.result_hash: 71e81843f5d75c414126fd83c8434ee251c7ee6ae0baaaf8bfe93f2a60f2ebeb
