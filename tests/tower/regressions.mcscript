# Every tower-loss fixture, replayed through the simulator.
#
#   mechcore run tests/tower/regressions.mcscript
#
# This needs no game. The hashes are what the game recorded with
# `levels.mcscript` and `both.mcscript`, seed 4242, and the simulator
# reproduces each fight tick for tick, physics and content, from the layout
# and the seed alone. `README.md` says what each fight separates.

steps:
  # Level 0: the loss writes buff 1, 180 ticks; the tower has 3400 life.
  - fight.run:
      layout: tests/tower/tower-level-0.yaml
      seed: 4242
    expect:
      steps: 870
      hashes.physics_result_hash: 38b688cdea7a64e5d8791efe0a3b8016a1586b1eb1db8f8b3fa37b6b7d7093a4
      hashes.content_result_hash: 30369b3ddf49c42dd2ca1835db6be8800e01a187c050c955fe099be15113fd4e
  # Level 1: 23400 life, buff 2, 140 ticks.
  - fight.run:
      layout: tests/tower/tower-level-1.yaml
      seed: 4242
    expect:
      steps: 925
      hashes.physics_result_hash: 4c9ba43900ace80f6876a1e245197acd874cba9ec1cfa63720d6a54364cdb0bd
      hashes.content_result_hash: 176b015e3fc687837f026e9be8fcbe407e1c0dd533faf89fc9b52511d3d98833
  # Level 2: 59400 life, buff 3, 100 ticks.
  - fight.run:
      layout: tests/tower/tower-level-2.yaml
      seed: 4242
    expect:
      steps: 928
      hashes.physics_result_hash: 1f64134e59262c1b52f2f0a9a17469b2176e350dfcd3705f14e2b4ee1d6f50f1
      hashes.content_result_hash: c3ef142df2f213c01e5947d3c1a4a9fb1e302c6d2461d71595298db5c8eae963
  # Level 3: 131400 life, buff 4, 60 ticks.
  - fight.run:
      layout: tests/tower/tower-level-3.yaml
      seed: 4242
    expect:
      steps: 964
      hashes.physics_result_hash: 940a835093341b610161f83f3330bbfef793a35b6823e2755df16018d1150942
      hashes.content_result_hash: 12f54136b8929b8c4b04fdb7b209403973d0d7debb47fc97ffd7572b8766006a
  # Level 4: 235400 life, buff 5, 20 ticks.
  - fight.run:
      layout: tests/tower/tower-level-4.yaml
      seed: 4242
    expect:
      steps: 959
      hashes.physics_result_hash: c248fee27a779c069c5b48a9efc8db5eb32c98ccc60bd259c4fba792d1f21c75
      hashes.content_result_hash: bd2bcbfaa37fa84e87d5da4f6518095859a4a08c6bc32e6646add82e476c1a25
  # A second level-0 loss inside the first: the debuff lasts 180 ticks longer.
  - fight.run:
      layout: tests/tower/both-towers-0-0.yaml
      seed: 4242
    expect:
      steps: 581
      hashes.physics_result_hash: 717b60369e90478026e59cbd39430a849d48908c8e6c36de908403aa7f07c004
      hashes.content_result_hash: 74cf1e00fef6044da95210ea885981900c4bd8e8f9a4ee894c3a87ea87349db9
  # A level-4 loss inside a level-0 one: 180 + 20, gone at tick 431.
  - fight.run:
      layout: tests/tower/both-towers-0-4.yaml
      seed: 4242
    expect:
      steps: 641
      hashes.physics_result_hash: 03f6e4220575c240d944d304ca5f36f4102f593d10dc636f8f702e24d8819a86
      hashes.content_result_hash: 3a847ff104488b5b8331c98b688487acb5612db54da42dc8e9a2ecd49c04774a
