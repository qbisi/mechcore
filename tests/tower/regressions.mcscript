# Every tower-loss fixture, replayed through the simulator.
#
#   mechcore run tests/tower/regressions.mcscript
#
# This needs no game. The hashes are what the game recorded with
# `levels.mcscript` and `both.mcscript`, seed 4242, and the simulator
# reproduces each fight tick for tick, physics and content, from the layout
# and the seed alone. `README.md` says what each fight separates.

steps:
  # Level 0: the loss writes buff 1, 180 ticks; the tower has 3400 life.
  - fight.run:
      layout: tests/tower/tower-level-0.yaml
      seed: 4242
    expect:
      steps: 870
      hashes.physics_result_hash: 26a0c34043ca65a306071e010959a7baebc9b622e63788b7ef25a75f938ad181
      hashes.content_result_hash: 380d721bf2aa581622f521e4386160a0b5eedfb16ffed7b477b7e288c31534ef
  # Level 1: 23400 life, buff 2, 140 ticks.
  - fight.run:
      layout: tests/tower/tower-level-1.yaml
      seed: 4242
    expect:
      steps: 925
      hashes.physics_result_hash: 32b469ea0451d7195187c32f29e7b1e58049e5fa4fe930d9dee4be745859a533
      hashes.content_result_hash: 0c322396fa3a49b031760c50b21fd04c511f85b5152719d616f9bc00ae169bd4
  # Level 2: 59400 life, buff 3, 100 ticks.
  - fight.run:
      layout: tests/tower/tower-level-2.yaml
      seed: 4242
    expect:
      steps: 928
      hashes.physics_result_hash: 63f015e8411b3bd79644a50213585e36e799720439ff16ef3d1cc448517c37c4
      hashes.content_result_hash: 9cbe8fedcb637c051d984abd8f497dfd0a10feea2d655b645fd2825a60463d66
  # Level 3: 131400 life, buff 4, 60 ticks.
  - fight.run:
      layout: tests/tower/tower-level-3.yaml
      seed: 4242
    expect:
      steps: 964
      hashes.physics_result_hash: 73301ee994563eb8eb52e47a6b6248b676882aeef93be5c68b9bbfab47c6937c
      hashes.content_result_hash: 4f36aa35d78f73aa3d69def0f1364305d3692289a26a99e96a59604b6b948cb3
  # Level 4: 235400 life, buff 5, 20 ticks.
  - fight.run:
      layout: tests/tower/tower-level-4.yaml
      seed: 4242
    expect:
      steps: 959
      hashes.physics_result_hash: 1b60216787c34dcdd808952d76f92c6d28ecab4681ae6ca9672f60b1a61e6f90
      hashes.content_result_hash: 0b355797b24b297bbab7d63b9c3236a241a5837c48078e5a5cfe1dd86fc04705
  # A second level-0 loss inside the first: the debuff lasts 180 ticks longer.
  - fight.run:
      layout: tests/tower/both-towers-0-0.yaml
      seed: 4242
    expect:
      steps: 581
      hashes.physics_result_hash: b7b5409d61112f1aeb57a6fda75f31b85424801f536bd956063d00055cb07ea6
      hashes.content_result_hash: cd73fdc16bc6af905c810fa8e02ab3179377c8b039856c3a51937e47262460e6
  # A level-4 loss inside a level-0 one: 180 + 20, gone at tick 431.
  - fight.run:
      layout: tests/tower/both-towers-0-4.yaml
      seed: 4242
    expect:
      steps: 641
      hashes.physics_result_hash: e3fdaff274c7ab123a0495758260ca4b0dbda7dcf285bfd1aa197491d7c7f65c
      hashes.content_result_hash: 71e81843f5d75c414126fd83c8434ee251c7ee6ae0baaaf8bfe93f2a60f2ebeb
