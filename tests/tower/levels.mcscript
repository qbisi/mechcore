# What does losing a tower write on its side's units, level by level?
#
#   mechcore run tests/tower/levels.mcscript --check   parse without the game
#   mechcore run tests/tower/levels.mcscript           record
#
# One fight per strengthen level, 0 to 4: red's Steel Balls take blue's
# Energy Tower, and blue's Fangs at the back carry what the loss writes.
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/tower/levels

steps:
  - let:
      levels: [0, 1, 2, 3, 4]
  - foreach: {level: $levels}
    steps:
      - convert:
          to: mcfr
          backend: game
          input: tests/tower/fights/tower-level-${level}.yaml
          output: ${out}/tower-level-${level}.mcfr
