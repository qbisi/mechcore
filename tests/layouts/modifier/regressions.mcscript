# Every fixture in this directory, replayed through the simulator.
#
#   mechcore run tests/layouts/modifier/regressions.mcscript
#
# This needs no game, which is why CI runs it: the hashes below are what the
# game recorded, and the simulator has to reproduce each one tick for tick
# from the layout and the seed alone. The recordings themselves live under
# `work/`, which is not tracked; what is tracked is what they decided.
#
# The other scripts here produce these numbers. `composition.mcscript`,
# `impairment.mcscript` and `value.mcscript` each launch the game, record, and
# assert the same values against the recording; this one asserts them against
# the simulator. A clause of the composition rule that `data.rs` got wrong
# fails here without anybody opening the game.
#
# Both hash layers are pinned. The physics hash is what the game recorded and
# has not moved since these fixtures were first captured; the content hash
# covers the derived numbers a recording now carries, so a composition rule
# that resolved to the wrong number fails here even when the fight's outcome
# would have looked the same.
#
# `README.md` says what each fixture changes and which clause it measures.

steps:
  # The control: no officer at all. It fixes the description and the pipeline,
  # so a failure here is not about modifiers.
  - fight.run:
      layout: tests/layouts/modifier/officer-composition-none.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 14639
      hashes.physics_result_hash: 075c230640b049bddb88084752a4f7599ba58f1df757ec275c1624e0da8081a9
      hashes.content_result_hash: b4618383ebacd52875cc37887ac83fae342e0f8ba986f33c0a5559d527899822

  # One enhancement, and two of them summing: 2329 x 1.3 and x 1.6.
  - fight.run:
      layout: tests/layouts/modifier/officer-composition-once.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 13243
      hashes.physics_result_hash: 71b59177811277d38d63be58d6cb919f94ac14d9b29f2765297920f732faf376
      hashes.content_result_hash: d2af2387af26f54b085a4b157c57d1dda709b2b487e3a985694ddff9a996cf5d
  - fight.run:
      layout: tests/layouts/modifier/officer-composition-twice.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 11845
      hashes.physics_result_hash: f41478211eb3bb389e1aa72f226d1dd222095238ba1de42b7dbbe283a55ba0a1
      hashes.content_result_hash: 361cf98648a68ad5141e8aac796232a3b4bce7b31fe2da92c7747b87f99a8330

  # An enhancement in the unit channel instead of a skill's: life, not damage.
  - fight.run:
      layout: tests/layouts/modifier/officer-life-rate.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 20428
      teams.1.max_life: 25086
      hashes.physics_result_hash: a59b3ed21921bb789ac91814f6769ac5ab7e9fa707bee6365f0b97438ab6a289
      hashes.content_result_hash: f32ffc821a2d198bef34e78d50af426ba952d187acd9d668ac194e60e448e4f1

  # One impairment, which both candidate rules agree about, and two, which
  # separate them: 0.89 x 0.89 leaves 15285 whole, and 1 - 0.22 leaves 15051.
  - fight.run:
      layout: tests/layouts/modifier/officer-impair-once.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 12516
      teams.1.max_life: 17174
      hashes.physics_result_hash: 63d2e62ace717f23f98c60316c985af170f79f94f07d0f24b09cd7ad89837b69
      hashes.content_result_hash: 66fc6ddc0bf40646a5cb04c342d5be9ea04735d9a85bf65ef560fc50005a7550
  - fight.run:
      layout: tests/layouts/modifier/officer-impair-twice.yaml
      seed: 4242
    expect:
      steps: 120
      teams.1.remaining_life: 10627
      teams.1.max_life: 15285
      hashes.physics_result_hash: 748447c302915373c9add912eb826ed053e811c3a8e736d0ec6dc84129371a21
      hashes.content_result_hash: 5e225ff1790e1c1843b71db0dc767ba07b2d972c093916def3388b9f3b8fe504

  # A value and an impairment in one fight, against the same fight without
  # them. Twenty metres of range moves every tick after the first shot.
  - fight.run:
      layout: tests/layouts/modifier/officer-range-none.yaml
      seed: 4242
    expect:
      steps: 137
      teams.1.remaining_life: 16377
      hashes.physics_result_hash: dbd4b7304520721e75701f77c3658ed5dfdbd21035f652e2ddf68bb3ed8810ba
      hashes.content_result_hash: 8267e51482b5832b1ebc98b33663f194b91560f79cd61ad1f4f90d8ca04fa8e2
  - fight.run:
      layout: tests/layouts/modifier/officer-range-value.yaml
      seed: 4242
    expect:
      steps: 137
      teams.1.remaining_life: 16961
      hashes.physics_result_hash: 63871702be6cd5cb0dc6041a1b6d2a0572a06b45f676d5c9112790409d7ec282
      hashes.content_result_hash: 3d88173d7f94a974539e162291e8458ed23a536276c6246b181e8bee2a3a4748

  # A plain integer, summed: 16 m/s becomes 19 and then 22, and the walk to
  # the Marksman is the whole clock. The life left is the same in all three
  # because the Marksman lands two shots either way — the reading is the tick
  # the fight ends at.
  - fight.run:
      layout: tests/layouts/modifier/officer-speed-once.yaml
      seed: 4242
    expect:
      steps: 104
      teams.1.remaining_life: 14639
      hashes.physics_result_hash: f263a6ec4d94dfd0980244aa5225713cc3ecaeb08ba5013d316832ee6e56e4a8
      hashes.content_result_hash: 949d59ab0573d189c19f8979a9c4979302f52521345b8d61db7cab4ab9c1dba0
  - fight.run:
      layout: tests/layouts/modifier/officer-speed-twice.yaml
      seed: 4242
    expect:
      steps: 92
      teams.1.remaining_life: 14639
      hashes.physics_result_hash: 99d1a0a06d0fc056fe506dd588af2ac3e667f70d36ba640bf87853859c7e23f3
      hashes.content_result_hash: 283993c4ffc1c4ae13b99ff24fae30324271abfda5cf6ecad4320f729c646ba0

  # Two sources on one number: an officer's `+20` of range and a technology's
  # `+40`. The fight is the one above to the tick — the Arclight was already in
  # range — so the physics hash repeats and only the content hash, which covers
  # the number the build computed, tells the two apart.
  - fight.run:
      layout: tests/layouts/modifier/technology-range.yaml
      seed: 4242
    expect:
      steps: 137
      teams.1.remaining_life: 16961
      hashes.physics_result_hash: 63871702be6cd5cb0dc6041a1b6d2a0572a06b45f676d5c9112790409d7ec282
      hashes.content_result_hash: 3f5926c03a23f26e5924c1ed8c60aee0a738f87a1dd29ff51ae353382d50744a

