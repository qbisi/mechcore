# The turret fixtures, replayed through the simulator.
#
#   mechcore run tests/turret/regressions.mcscript
#
# This needs no game, which is why CI runs it: each hash below is the one the
# game recorded for the fixture in `skill.mcscript`, and the simulator has to
# reproduce it tick for tick from the layout and the seed alone. Both layers
# are pinned, and both are the game's: the physics hash holds where every
# Crawler and every shot is and what each shot hit, the content hash holds the
# rest — every lock, every motion state, the numbers derived for each unit.
#
# A Rapid-Fire Turret fires ten shots, reloads, and fires again. What these
# two fights pin, `docs/rules/constructions.md` states as rules: the skill
# locks and enters its attack on the first tick a Crawler is in reach edge to
# edge, fires on the tick after, draws every interval from its side's stream
# after the Marksman's and its own deployment draw, turns its weapon at 120
# degrees a second and scores its next target from where it points, and after
# the tenth shot spends 53 ticks reloading before the eleventh.
#
# `anti-armor-arclights.yaml` is the Anti-Armor Turret's fight: eight shots
# at four Arclights, the magazine's six, a reload of 200 ticks, and two more.
# `anti-armor-head-on.yaml` is not here. The simulator plays it tick for tick
# up to tick 508, the Anti-Armor Turret's six shots and its fall at 335
# included; at 509 the Crawlers take blue's Energy Tower, and the game
# weakens the Marksman for it, which is a mechanism of its own this
# build does not model.

steps:
  # Crawlers straight down the turret's column. 24 fall to the turret, which
  # nothing reaches, and the fight ends when the last does: 237 ticks.
  - fight.run:
      layout: tests/turret/rapid-fire-head-on.yaml
      seed: 4242
    expect:
      steps: 237
      winner: blue
      teams.0.remaining_life: 1622
      hashes.physics_result_hash: a8354829bdecec0edc27bf52ddfe3d1db5322c2c4a6ad3dd31021eca0aac84c6
      hashes.content_result_hash: 81d56dd91855a7d154b58e5d0883839c14e2b48337464f3c04d8a7777c917a0a

  # The same Crawlers 36.6 degrees off the turret's column. The weapon has
  # turned onto its lock before the lock is in reach, so the first shot is as
  # early, counted from reach, as the head-on one: 234 ticks.
  - fight.run:
      layout: tests/turret/rapid-fire-flank.yaml
      seed: 4242
    expect:
      steps: 234
      winner: blue
      teams.0.remaining_life: 1622
      hashes.physics_result_hash: 4dd9d40c90bcbdd137eaeea10420e042a31f8ac40ab84f769b672fa6d0e92145
      hashes.content_result_hash: 9cea5f499bbc035385edda2e4624e9a452ea96deaca35c3442ebeb3f7dc12603

  # Four Arclights down the Anti-Armor Turret's column, two shots each. The
  # sixth shot empties the magazine at 574, the reload runs to 776, and the
  # seventh and eighth kill the last at 836. No tower falls.
  - fight.run:
      layout: tests/turret/anti-armor-arclights.yaml
      seed: 4242
    expect:
      steps: 836
      winner: blue
      teams.0.remaining_life: 1622
      hashes.physics_result_hash: c27a0e744b8da5c0e8b91ea50546b4b39e38a4d3e550c5b4eebf881705915aed
      hashes.content_result_hash: dcfa4c6d7d828707d75b8624c05ed63306e81098ac10103221d927bea7a8b80a

  # The Anti-Armor Turret against a Crawler, the Marksman behind. Blue loses
  # a tower at 509 and red at 771, and at 1027 the Marksman ends its attack
  # when its live lock walks out of reach, as every skill does.
  - fight.run:
      layout: tests/turret/anti-armor-head-on.yaml
      seed: 4242
    expect:
      steps: 1397
      hashes.physics_result_hash: 4ee3e9f04ed6285ea8134cb82fd51b20c52e5b8bbf2c94012c26db8221a59dda
      hashes.content_result_hash: 8fa98d317a6edeadc6ef5bc93bb39bd87412d38729e88b517d4be488d1ec19fa
