# The Anti-Armor Turret through a reload, in a fight no tower falls in.
#
#   mechcore run tests/turret/arclights.mcscript --check   parse without the game
#   mechcore run tests/turret/arclights.mcscript           record
#
# `anti-armor-head-on.yaml` asked whether the Anti-Armor Turret is the Rapid-
# Fire Turret's machine with other numbers, and its Crawlers take blue's
# Energy Tower at tick 509, which weakens the Marksman (#104). This fight asks
# the same without a tower in the way, and asks more of it: four Arclights,
# two shots each, so the six-round magazine empties and reloads before the
# last one dies. It is recorded twice, and the two have to be one recording.
#
# `out` must not already exist: record_battle refuses to overwrite.

game: launch

vars:
  out: /tmp/mechcore/turret/arclights
  seed: 4242

steps:
  - let:
      layout: read_yaml(tests/turret/anti-armor-arclights.yaml)
  - game.apply_layout:
      layout: $layout
      seed: $seed
  - game.record_battle:
      output: ${out}/anti-armor-arclights.mcfr
      instrumentation:
        output: ${out}/anti-armor-arclights.h5
        profile: target_refs_v1
  - game.apply_layout:
      layout: $layout
      seed: $seed
  - game.record_battle:
      output: ${out}/control.mcfr
  - fight.compare:
      left: ${out}/anti-armor-arclights.mcfr
      right: ${out}/control.mcfr
    expect:
      equal: true
      content_equal: true
