# Every equipment fixture, replayed through the simulator.
#
#   mechcore run tests/equipment/regressions.mcscript
#
# This needs no game. The hashes below are what the game recorded with
# `stats.mcscript`, seed 1787720817, and the simulator has to reproduce each
# one tick for tick from the layout and the seed alone. Both hash layers are
# pinned: the content hash covers the unit and skill `DataSet` aggregates, so
# an equipment written into the wrong channel fails here even where the
# fight's physics would not move.

steps:
  # The control: the Marksman with nothing on it.
  - fight.run:
      layout: tests/regression/marksman-vs-arclight.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: c983448bd700fac15c567006356d096fa81c7dd950f2808665b8a235c4dc4566
      hashes.content_result_hash: c67619a04b21c97cb9aa60037a690362c4948546945448267efe5465d2b59814
  # Heavy Armor alone: +0.75 of life in the unit channel, 2838.
  - fight.run:
      layout: tests/equipment/heavy-armor.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: 59703c35333f208df4243c80441353e6f86f100ed9081e032eec2b1ac3f777e7
      hashes.content_result_hash: 8eaf455aa3b02ac63971144cc0a3e21e83ce0d8f3264508d2f8175562bace329
  # With Advanced Defensive Tactics: the two rates sum, 3325.
  - fight.run:
      layout: tests/equipment/heavy-armor-officer.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: 64f4bedbdd104e5021a309c57998a1288730c552384e487720d4151ce37ac828
      hashes.content_result_hash: 14ba8c8842162f23d2c9bb4b8e829132618df5d647bc0dfcfc9060e03e9f4f7b
  # Improved Firepower Control System: +0.65 of damage in the skill channel, 3842.
  - fight.run:
      layout: tests/equipment/firepower.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: f3554a79145bd3fb31cd506f5cf3d9fd5ffcf0c82c8afb31c389850f4e0fca17
      hashes.content_result_hash: 27fa1486d768c5b11c8ee5e94143e4d2b48d95446dd736cf37dce5693773e849
  # With Advanced Offensive Tactics: the two rates sum, 4541.
  - fight.run:
      layout: tests/equipment/firepower-officer.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: 3e40a89138f90a30f5e641b9a5119b864dddf0b2ab2a5e8eb5a263f0739591d1
      hashes.content_result_hash: 86f01a57ce4c859f15aa68bf16a64834f79dec4bc990f268ce2decb46721302c
  # Laser Sights: +20 m of range. The target starts in reach, so the fight is
  # the control's and only the content hash tells them apart.
  - fight.run:
      layout: tests/equipment/laser-sights.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: c983448bd700fac15c567006356d096fa81c7dd950f2808665b8a235c4dc4566
      hashes.content_result_hash: 04c22d6fc142719d14f2314de970106286917436665ddbef5fba2d4dc96378b8
  # The far control: 170 m apart, the Marksman walks before it fires.
  - fight.run:
      layout: tests/equipment/far-control.yaml
      seed: 1787720817
    expect:
      steps: 165
      hashes.physics_result_hash: fb08b5c930b68ed334decd11035cc4453088517796578101a2e3cfec668cd120
      hashes.content_result_hash: f508abc4d569ecb267c8e51b91a49ef65f7a2c178669fed553ec77e91c4f8697
  # Laser Sights at 170 m: the range acts, and the first shot comes sooner.
  - fight.run:
      layout: tests/equipment/laser-sights-far.yaml
      seed: 1787720817
    expect:
      steps: 140
      hashes.physics_result_hash: dce683ebed004c4c3dd0fed72780918b7d19299ee57fe3539579f98da88998db
      hashes.content_result_hash: 9ba8424c9eeb199ae1bb4b8f14f481f9a4cb4bf72cef348715bc13f63597a466
  # Two items under Equipment Expansion: Heavy Armor's life and the Firepower
  # Control System's damage both land, 2838 of life and shots of 3842.
  - fight.run:
      layout: tests/equipment/two-items.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: b17cb8b3af4ebe7ca043c73846890afbe73f7f5a1566d88d8eb4b4060a36537b
      hashes.content_result_hash: 51e1e2f99a32c0d09c98d958adec371add337a2744be8bd6d9edfcba63d65a25
