# Every equipment fixture, replayed through the simulator.
#
#   mechcore run tests/equipment/regressions.mcscript
#
# This needs no game. The hashes below are what the game recorded with
# `stats.mcscript`, seed 1787720817, and the simulator has to reproduce each
# one tick for tick from the layout and the seed alone. The hash covers the
# unit and skill `DataSet` aggregates, so an equipment written into the wrong
# channel fails here even where no unit would move differently.

steps:
  # The control: the Marksman with nothing on it.
  - convert:
      input: tests/regression/marksman-vs-arclight.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 91
      hashes.result_hash: a13716e2e17d0ca5c5cfbaea8c770a98b9c4f892b38f6bfbc6c83338ccdc82b4
  # Heavy Armor alone: +0.75 of life in the unit channel, 2838.
  - convert:
      input: tests/equipment/heavy-armor.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 139
      hashes.result_hash: 286eb767c78308758a9b4cb6b8e6bf9bd7dcd33a1c8f95b8bad690a7336fde89
  # With Advanced Defensive Tactics: the two rates sum, 3325.
  - convert:
      input: tests/equipment/heavy-armor-officer.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 139
      hashes.result_hash: 368b54043674eb07394771990d55bec9e42d844d8da7696f327b733882fcc0e2
  # Improved Firepower Control System: +0.65 of damage in the skill channel, 3842.
  - convert:
      input: tests/equipment/firepower.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 83
      hashes.result_hash: e39dd7a71d4dbe6c278f493b02b0b7b70d3f298c54916ab14fc722850f7013b4
  # With Advanced Offensive Tactics: the two rates sum, 4541.
  - convert:
      input: tests/equipment/firepower-officer.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 83
      hashes.result_hash: 6b85af16ca94b702788d2d39aeb253ff4ed8624a11a897ec564eedce47eac6d2
  # Laser Sights: +20 m of range. The target starts in reach, so the fight is
  # the control's in motion, and only the unit's range tells them apart.
  - convert:
      input: tests/equipment/laser-sights.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 91
      hashes.result_hash: 4d40b05b9ecdab8f6b63bef4d7fe79aeab0964891be3437ae7850de2eb33aba6
  # The far control: 170 m apart, the Marksman walks before it fires.
  - convert:
      input: tests/equipment/far-control.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 165
      hashes.result_hash: 6d2a65598d395ed6d9c0ad238b664332fe82676aabcaa25ba11e4c79a211ff81
  # Laser Sights at 170 m: the range acts, and the first shot comes sooner.
  - convert:
      input: tests/equipment/laser-sights-far.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 140
      hashes.result_hash: 885538becfc2f454b5658a108e16055aea440713b4968e1e4ebf1f941a06e784
  # Two items under Equipment Expansion: Heavy Armor's life and the Firepower
  # Control System's damage both land, 2838 of life and shots of 3842.
  - convert:
      input: tests/equipment/two-items.yaml
      to: mcfr
      seed: 1787720817
    expect:
      steps: 83
      hashes.result_hash: aee51d0bc7308f13aa68b52a7b383a7203ebaf232f0f25571cf577eb693fe6cc
