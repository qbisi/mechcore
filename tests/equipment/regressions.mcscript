# Every equipment fixture, replayed through the simulator.
#
#   mechcore run tests/equipment/regressions.mcscript
#
# This needs no game. The hashes below are what the game recorded with
# `stats.mcscript`, seed 1787720817, and the simulator has to reproduce each
# one tick for tick from the layout and the seed alone. Both hash layers are
# pinned: the content hash covers the unit and skill `DataSet` aggregates, so
# an equipment written into the wrong channel fails here even where the
# fight's physics would not move.

steps:
  # The control: the Marksman with nothing on it.
  - fight.run:
      layout: tests/regression/marksman-vs-arclight.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: 4277bde999f9a4ab9cdda0bff3c61f643f41486d46642fb6c46869f3448f0914
      hashes.content_result_hash: d54c7c7e1fee9b67a02a749c86df56b9985e2440831cb8273c486de8d4accf3e
  # Heavy Armor alone: +0.75 of life in the unit channel, 2838.
  - fight.run:
      layout: tests/equipment/heavy-armor.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: d4fefc6b1702a2e3b433192dcb26e7486ab6ca98ea9dfe65c4ce3c3db01b0500
      hashes.content_result_hash: b1fce02ad05adbc927ee647e922fe7a1de8cf50af62c42aebf81bb04c43d0a7f
  # With Advanced Defensive Tactics: the two rates sum, 3325.
  - fight.run:
      layout: tests/equipment/heavy-armor-officer.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: 819bfc04a63ee3821b9b93c3211a7dec65174ea006ae0f895c077ca81920ff59
      hashes.content_result_hash: 8878ce2cd1b642be7098f18adf90290cc1d8023082bd52872239fdefbd2ba50f
  # Improved Firepower Control System: +0.65 of damage in the skill channel, 3842.
  - fight.run:
      layout: tests/equipment/firepower.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: aa773b1b964b5457c975b8775950a79433dea41348657acd64c1c6b96f0c8cb5
      hashes.content_result_hash: b6304c910d6abe399d9800d2d6d1a86c2a521a2e4123a99613c71d10ae5db6c2
  # With Advanced Offensive Tactics: the two rates sum, 4541.
  - fight.run:
      layout: tests/equipment/firepower-officer.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: b935261a18eaba5bfac13f6fce0e6ded0e7cc02635a044fb622d8ac99d47b0ca
      hashes.content_result_hash: eacd46ab8052f0fc6460635ff428801f9d33839e49cf3bf65844bed40b995f2d
  # Laser Sights: +20 m of range. The target starts in reach, so the fight is
  # the control's and only the content hash tells them apart.
  - fight.run:
      layout: tests/equipment/laser-sights.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: 4277bde999f9a4ab9cdda0bff3c61f643f41486d46642fb6c46869f3448f0914
      hashes.content_result_hash: 6f57b7ca6c7fb23a82949441bdc995ceb0249b38b58f435b2a43e0e77f5cc9b8
  # The far control: 170 m apart, the Marksman walks before it fires.
  - fight.run:
      layout: tests/equipment/far-control.yaml
      seed: 1787720817
    expect:
      steps: 165
      hashes.physics_result_hash: 458a64173201c8483e9dbc6a45da443c9b97bb8e9c61bc0822a5ab2db1b34350
      hashes.content_result_hash: 35386936d24d7c440db5767b93d33626d820011588440b3796f036a8038b1a28
  # Laser Sights at 170 m: the range acts, and the first shot comes sooner.
  - fight.run:
      layout: tests/equipment/laser-sights-far.yaml
      seed: 1787720817
    expect:
      steps: 140
      hashes.physics_result_hash: 94ebb1a8320beb3127785a74a3cb7aa8b344fa2db9d914b1688162ff612bca6f
      hashes.content_result_hash: 523dc1d75f8b6ba336897a9f556091caca39fad06215e7b357d3de495a374598
  # Two items under Equipment Expansion: Heavy Armor's life and the Firepower
  # Control System's damage both land, 2838 of life and shots of 3842.
  - fight.run:
      layout: tests/equipment/two-items.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: f0bbc9196f1fe22ef8eceb8bd1155639aa66d5e2021f48a18db33fb9f46445e2
      hashes.content_result_hash: de0e94cf69110bcfe1b309539c82cb7e84ca0d5737647576f7c06fcc76e0159b
