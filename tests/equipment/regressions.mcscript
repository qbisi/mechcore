# Every equipment fixture, replayed through the simulator.
#
#   mechcore run tests/equipment/regressions.mcscript
#
# This needs no game. The hashes below are what the game recorded with
# `stats.mcscript`, seed 1787720817, and the simulator has to reproduce each
# one tick for tick from the layout and the seed alone. Both hash layers are
# pinned: the content hash covers the unit and skill `DataSet` aggregates, so
# an equipment written into the wrong channel fails here even where the
# fight's physics would not move.

steps:
  # The control: the Marksman with nothing on it.
  - fight.run:
      layout: tests/regression/marksman-vs-arclight.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: e8c1853ce824ab26652d8a5a76908ba9569486d77dc7c91cacd756fb131566b7
      hashes.content_result_hash: 6a58e9eaebf4c6bb72dc8c4ac16627422d29099bd9b04f66d76b671df67a708c
  # Heavy Armor alone: +0.75 of life in the unit channel, 2838.
  - fight.run:
      layout: tests/equipment/heavy-armor.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: 5fe4711b3f29af08cb20e1848f7ecacee3b01984efe00e6373c1e39721c31c2b
      hashes.content_result_hash: 433ccfa269e5f6665c6e077c47e9bfd9767ad3ba9b7b725507a9a03886e9681b
  # With Advanced Defensive Tactics: the two rates sum, 3325.
  - fight.run:
      layout: tests/equipment/heavy-armor-officer.yaml
      seed: 1787720817
    expect:
      steps: 139
      hashes.physics_result_hash: ebad60a892a6662b30019fc13d8e2af8e8663922aaf4dc329e67f9cb4164538e
      hashes.content_result_hash: 6bd60751a1ae057786d02198cd7ab4acb6ba01dd75b1267e7075b7b64024d692
  # Improved Firepower Control System: +0.65 of damage in the skill channel, 3842.
  - fight.run:
      layout: tests/equipment/firepower.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: 3f579c74dcf145f7b144160c3e67bfa01fb390cac9b577ffafb54b2da9952dd0
      hashes.content_result_hash: eb6feadc06a6ea2ff4ef5763e4e17aceace93dbd73c75deb9021824b768389b4
  # With Advanced Offensive Tactics: the two rates sum, 4541.
  - fight.run:
      layout: tests/equipment/firepower-officer.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: 3a001377ae4b14db7b15661b7cfc5b2d9cb9ce0e3f57e5321f9c9ee2de1b8048
      hashes.content_result_hash: f60416ae0314e892c20cf9cf917e2cc41529e15b620cf1b0baf274d5b06ed800
  # Laser Sights: +20 m of range. The target starts in reach, so the fight is
  # the control's and only the content hash tells them apart.
  - fight.run:
      layout: tests/equipment/laser-sights.yaml
      seed: 1787720817
    expect:
      steps: 91
      hashes.physics_result_hash: e8c1853ce824ab26652d8a5a76908ba9569486d77dc7c91cacd756fb131566b7
      hashes.content_result_hash: 20a1a4b0c9715ad1cdcf956fcd18d6bd0af4ec96ac9933dc5fbb15fa9dc8ee5b
  # The far control: 170 m apart, the Marksman walks before it fires.
  - fight.run:
      layout: tests/equipment/far-control.yaml
      seed: 1787720817
    expect:
      steps: 165
      hashes.physics_result_hash: cf18349b7ae445772905cbe9fbf95d228b6a7c7f53b05ab22c511376b7e2f2e0
      hashes.content_result_hash: 47c5556c5491df4859170e49d7621c9294e6154b5ea79f7bb161cc7f9597bf2f
  # Laser Sights at 170 m: the range acts, and the first shot comes sooner.
  - fight.run:
      layout: tests/equipment/laser-sights-far.yaml
      seed: 1787720817
    expect:
      steps: 140
      hashes.physics_result_hash: 42a98912fedf91211fd93b2d4d75202f703c338a3c9ef08628ffc2644e1f1934
      hashes.content_result_hash: 892efd8b0821341005f47c81b3f820957a389c3a555eef9835f1b6df154c4d01
  # Two items under Equipment Expansion: Heavy Armor's life and the Firepower
  # Control System's damage both land, 2838 of life and shots of 3842.
  - fight.run:
      layout: tests/equipment/two-items.yaml
      seed: 1787720817
    expect:
      steps: 83
      hashes.physics_result_hash: 94e2b75d957405fb437828f3b43c662d2f8b0087e0c9620e9ec31b7a5a1cab8c
      hashes.content_result_hash: 3fbc542fcd56586ce4987c82a45f3c9be34cfb3c03b3f8f11447433b9623f6d2
