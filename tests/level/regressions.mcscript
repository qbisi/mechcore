# Every fight this directory pins, fought again by the simulator.
#
#   mechcore run tests/level/regressions.mcscript
#
# This needs no game, which is why CI runs it. Each file under `fights/` is
# a fight the game recorded, holding its layout, its seed and what the
# recording decided, the tick count and the hash among it. `verify` fights
# the layout with the seed and holds the simulator to all of it, and the
# hash covers every field of every tick. `README.md` says what each fight
# measures.

steps:
  - let: {fights: glob(tests/level/fights/*.yaml)}
  - verify: {input: $fights}
    expect: {invalid: []}
