# Every unit's standard layouts, recorded with two seeds each.
#
#   mechcore run tests/units/record.mcscript --check   parse without the game
#   mechcore run tests/units/record.mcscript           record
#
# `plan.md` defines basic support: six standard layouts per unit, two seeds
# each, both hash layers. A unit that is its own opponent in a cell does not
# record it twice, so the Rhino has no M2 and the Crawler no M3.
#
# Each fight is fought without a scene, from a replay whose one round is the
# layout, and recorded as the Training Ground records it: the two hash the same.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch

vars:
  out: /tmp/mechcore/units

steps:
  - let:
      fights:
        - {unit: rhino, name: m1-mirror, layout: tests/units/rhino/m1-mirror.yaml, seed: 4242}
        - {unit: rhino, name: m1-mirror, layout: tests/units/rhino/m1-mirror.yaml, seed: 1787720817}
        - {unit: rhino, name: m3-crawler, layout: tests/units/rhino/m3-crawler.yaml, seed: 4242}
        - {unit: rhino, name: m3-crawler, layout: tests/units/rhino/m3-crawler.yaml, seed: 1787720817}
