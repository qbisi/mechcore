  - foreach: {fight: $fights}
    steps:
      - let:
          layout: read_yaml(${fight.layout})
      - game.apply_layout:
          layout: $layout
          seed: ${fight.seed}
      - game.record_battle:
          output: ${out}/${fight.unit}/${fight.name}-${fight.seed}.mcfr
