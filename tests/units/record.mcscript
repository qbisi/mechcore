# Every unit's standard layouts, recorded with two seeds each.
#
#   mechcore run tests/units/record.mcscript --check   parse without the game
#   mechcore run tests/units/record.mcscript           record
#
# `plan/units.md` defines basic support: six standard layouts per unit, two seeds
# each, each pinned by its hash. A unit that is its own opponent in a cell does not
# record it twice, so the Rhino has no M2 and the Crawler no M3.
#
# Each fight is fought without a scene, from a replay whose one round is the
# layout, and recorded as the Training Ground records it: the two hash the same.
#
# A pinned fight is recorded from its fixture under `fights/`, which states its
# own layout and seed, and lands under `out` at the fixture's own path. The
# Hacker's twelve are not pinned, so they are still layouts, one directory
# for the unit, recorded under each seed.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/units/record

steps:
  - let:
      fights: glob(tests/units/fights/*.yaml)
      unpinned:
        - {unit: hacker, name: m1-mirror, layout: tests/units/hacker/m1-mirror.yaml, seed: 4242}
        - {unit: hacker, name: m1-mirror, layout: tests/units/hacker/m1-mirror.yaml, seed: 1787720817}
        - {unit: hacker, name: m2-rhino, layout: tests/units/hacker/m2-rhino.yaml, seed: 4242}
        - {unit: hacker, name: m2-rhino, layout: tests/units/hacker/m2-rhino.yaml, seed: 1787720817}
        - {unit: hacker, name: m3-crawler, layout: tests/units/hacker/m3-crawler.yaml, seed: 4242}
        - {unit: hacker, name: m3-crawler, layout: tests/units/hacker/m3-crawler.yaml, seed: 1787720817}
        - {unit: hacker, name: m4-wasp, layout: tests/units/hacker/m4-wasp.yaml, seed: 4242}
        - {unit: hacker, name: m4-wasp, layout: tests/units/hacker/m4-wasp.yaml, seed: 1787720817}
        - {unit: hacker, name: m5-rotated, layout: tests/units/hacker/m5-rotated.yaml, seed: 4242}
        - {unit: hacker, name: m5-rotated, layout: tests/units/hacker/m5-rotated.yaml, seed: 1787720817}
        - {unit: hacker, name: m6-formations, layout: tests/units/hacker/m6-formations.yaml, seed: 4242}
        - {unit: hacker, name: m6-formations, layout: tests/units/hacker/m6-formations.yaml, seed: 1787720817}

  - foreach: {fight: $fights}
    steps:
      - game.record:
          input: $fight
          output: ${out}/${fight}.mcfr

  - foreach: {fight: $unpinned}
    steps:
      - let:
          layout: read_yaml(${fight.layout})
      - game.record:
          input: $layout
          seed: ${fight.seed}
          output: ${out}/${fight.unit}/${fight.name}-${fight.seed}.mcfr
