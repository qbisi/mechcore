# Which state is a unit's skill in, and where does its body face, while its
# weapons turn onto a new target?
#
#   mechcore run tests/units/skill-state.mcscript --check   parse without the game
#   mechcore run tests/units/skill-state.mcscript           record
#
# Re-records six standard fights with the `target_refs` instrument channel,
# which holds, per unit and tick, the main skill's state, beside the
# turret's rotation the recording itself carries. They are the
# fights that showed that leaving `SkillIdleState` waits a tick before the
# blow, and that an idle skill keeps its lock only while it can fire at it:
# the Fortress's weapons turning onto a Crawler, a Sledgehammer and a Typhoon
# locking a new target after a kill, and a Melting Point switching to the
# Crawler its weapons already face. The Phantom Ray's two M3 fights showed
# what a won fight does to a skill before it ends: one already cooling goes
# on cooling at its dead target, and one attacking goes idle. The fights are
# pinned under `fights/`, and each recording lands under `out` at its
# fixture's own path; the channel is research evidence, outside the hash.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/units/skill-state

steps:
  - let:
      fights:
        - tests/units/fights/fortress-m3-crawler-1787720817.yaml
        - tests/units/fights/sledgehammer-m3-crawler-1787720817.yaml
        - tests/units/fights/typhoon-m6-formations-4242.yaml
        - tests/units/fights/melting_point-m6-formations-1787720817.yaml
        - tests/units/fights/phantom_ray-m3-crawler-4242.yaml
        - tests/units/fights/phantom_ray-m3-crawler-1787720817.yaml

  - foreach: {fight: $fights}
    steps:
      - convert:
          to: mcfr
          backend: game
          input: $fight
          output: ${out}/${fight}.mcfr
          instrument: [target_refs]
