# In which skill state does a unit meet a wall?
#
#   mechcore run tests/construction/skill-state.mcscript --check   parse without the game
#   mechcore run tests/construction/skill-state.mcscript           record
#
# A recording says what a unit's weapons fire at, not which state its skill is
# in when it decides. This records the wall fights again with the
# `target_refs` instrument channel, which holds, per unit and
# tick, the main skill's `SkillStateController` state (`SkillIdleState`,
# `SkillPrepareState`, `SkillAttackState`, `SkillCoolingState`), its
# `SkillAttackController` phase (`before`, `attacking`, `after`, or none
# between blows), and its lock and attack target. That is what
# `docs/rules/constructions.md` reads for where a block is met and how an
# attack on one ends:
#
#   line-of-fire  the Marksman cools, lockless, on block 6 the tick after it falls
#   rhino         the Rhino finishes its swing on block 5, idles a tick, takes block 4
#   laser         a Steel Ball's prepared beam ends the tick block 3 enters its line
#   block         Crawlers end an attack between blows, or in the wait before one,
#                 when a nearer block comes into their line
#   splash        the Arclight re-locks behind block 5 the tick its lock dies
#   marksman      a dead unit is switched from and the attack goes on; the kill
#                 with no replacement in reach cools like a fallen block
#
# The recordings are the same fights the fixtures pin, recorded from them, and
# are compared with the simulator afterwards. The channel is research evidence, outside the hash.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/construction/skill-state

steps:
  - let:
      fights:
        - {name: line-of-fire, fight: tests/construction/fights/wall-line-of-fire.yaml}
        - {name: line-tolerance, fight: tests/construction/fights/wall-line-tolerance.yaml}
        - {name: rhino, fight: tests/construction/fights/wall-rhino.yaml}
        - {name: laser, fight: tests/construction/fights/wall-laser.yaml}
        - {name: block, fight: tests/construction/fights/wall-block.yaml}
        - {name: splash, fight: tests/construction/fights/wall-splash.yaml}
        - {name: splash-line, fight: tests/construction/fights/wall-splash-line.yaml}
        - {name: splash-behind, fight: tests/construction/fights/wall-splash-behind.yaml}
        - {name: marksman, fight: tests/regression/fights/crawlers-vs-marksman.yaml}

  - foreach: {fight: $fights}
    steps:
      - convert:
          to: mcfr
          backend: game
          input: ${fight.fight}
          output: ${out}/${fight.name}.mcfr
          instrument: [target_refs]
      - verify:
          input: ${out}/${fight.name}.mcfr
        expect: {invalid: []}
