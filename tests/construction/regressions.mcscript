# The wall fixture, replayed through the simulator.
#
#   mechcore run tests/construction/regressions.mcscript
#
# This needs no game, which is why CI runs it: the hash below is what the game
# recorded, and the simulator has to reproduce it tick for tick from the layout
# and the seed alone. The recording itself is written under `/tmp` and never
# tracked; what is tracked is what it decided.
#
# `placement.mcscript` and `line-of-fire.mcscript` are the other half. They
# launch the game, record the same layouts, and assert the same numbers against
# the recording rather than against the simulator.
#
# Both hash layers are pinned, and both are the game's. The physics hash holds
# where everything is and what it hit; the content hash holds everything else a
# recording carries — a unit's lock, its weapons' targets, its motion state and
# the numbers derived for it — so a fight whose physics still matches but whose
# units are directed at something else fails here too.

steps:
  # A Defensive Wall, 256 metres from either unit, changes nothing about the
  # fight and everything about what is standing in it. The hash covers both:
  # it is the game's, and it holds the five blocks as well as the two units.
  - fight.run:
      layout: tests/construction/wall-aside.yaml
      seed: 4242
    expect:
      steps: 91
      winner: red
      teams.1.remaining_life: 155
      hashes.physics_result_hash: 4523d7309ed89aa0fd1fb43a067f4d914af4d655b8da94b43cec9ac8878f0927
      hashes.content_result_hash: b72c1106879bd4c574991bd0347b965b5d540ada7c943ad5dcf96d08a5413aa7

  # A wall in the way. One Marksman shoots past the wall at the unit behind
  # it, and the block it destroys is neither the nearest block nor the one its
  # line passes closest to — it is the nearest of the blocks the line reaches.
  # `docs/rules/constructions.md` measured that and this holds the simulator
  # to it: 20 ticks, block 6 down, everything else standing.
  - fight.run:
      layout: tests/construction/wall-line-of-fire.yaml
      seed: 4242
    expect:
      steps: 20
      winner: blue
      hashes.physics_result_hash: b67ee482c84b78665455f585b37b8fd33aecf84024f74366d4b908ee3fbbecd8
      hashes.content_result_hash: 333055f39699733161f04f7e4711dc68a47f4c0ede0f3a3dcbedf1eb99a6098f

  # The same question four times at once, which is what bracketed the width,
  # and the fight where a tick that lands two shots reports the fallen block
  # after both of them.
  - fight.run:
      layout: tests/construction/wall-line-tolerance.yaml
      seed: 4242
    expect:
      steps: 19
      winner: red
      hashes.physics_result_hash: dc9a77c75eab511539a7b0556bd9f0efcf495aa484e026157e1e19ddc7a46099
      hashes.content_result_hash: 3ccefd54721612f7c31336ec8673e2c6b6cbd2e7e47535936f7b02862a279cd5

  # A flying unit with four weapon slots against a wall, from its approach to
  # the end: the core and then every slot take the block in the way, a shot at
  # one block splashes the next for its full damage, the slots are dropped
  # with the lock when a block falls, and the Wraith turns back to the
  # Marksman once the blocks in its way are gone. 242 ticks, the game's hash.
  - fight.run:
      layout: tests/construction/wall-weapon-group.yaml
      seed: 4242
    expect:
      steps: 242
      winner: red
      hashes.physics_result_hash: 71bdc736cefec8f464e50775dfacff94f24cb2540109223c270a40f3968e19bf
      hashes.content_result_hash: aeec79ba1c8db0006897981fbdd32b398f818a9aaed109cbd7b67f20aa8a7239

  # A blow, and not a shot. The Rhino takes the block in its line one hit at a
  # time, stays on each until its swing is over, reads idle for a tick, and
  # takes the next thing in its way. 189 ticks, the game's hash; its content
  # hash agrees as well, which `attacks.mcscript` checks against the game.
  - fight.run:
      layout: tests/construction/wall-rhino.yaml
      seed: 4242
    expect:
      steps: 189
      winner: red
      hashes.physics_result_hash: 44ae3c4c81b15563f6a7b924591385baf12813c27714d4d23cb7a2ebe25cdf1f
      hashes.content_result_hash: 70e976ec3367fec2f6183dbf181086fcacd1e0d7348a761eb639b4b96a80b815

  # A beam, and a block in the way of a unit's movement. Four Steel Balls take
  # three blocks with the beam's ramp, and one of them, overlapping block 3, is
  # pushed off it: to the other side a block is an immovable obstacle on the
  # wall's own collider layer. 243 ticks, the game's hash, and its content hash
  # agrees too, which `attacks.mcscript` checks against the game.
  - fight.run:
      layout: tests/construction/wall-laser.yaml
      seed: 4242
    expect:
      steps: 243
      winner: red
      hashes.physics_result_hash: 6cfed0b5e5bff3304b97e87d582d3b7043f95d72a34670267d9b73b5f28ad43b
      hashes.content_result_hash: 9b84885e238a31bd675911e4667eab90e31f3fed4cdc8c80d1ce6ac9b6945ab6

  # The side that placed the wall, crossing it. Twenty-four Crawlers walk
  # through their own blocks, which still take places among their twenty
  # neighbours and yield them no obstacle. 341 ticks, the game's hash.
  - fight.run:
      layout: tests/construction/wall-passage.yaml
      seed: 4242
    expect:
      steps: 341
      hashes.physics_result_hash: 742ab9964980d2df6bca04e90546f5e54f3ea91e317158e639e3923875ec552c
      hashes.content_result_hash: e74ef9a00f918e8560a73c09b42eb12298bdd32d4db78dfa731cba96804bfd9b

  # The other side, stopped by the wall and taking it down. Twenty-four
  # Crawlers pushed along the wall as they strike it change blocks between
  # blows, go straight on when a block they had not yet struck falls, and take
  # four of the five before the fight ends. 209 ticks, the game's hash; its
  # content hash agrees too.
  - fight.run:
      layout: tests/construction/wall-block.yaml
      seed: 4242
    expect:
      steps: 209
      hashes.physics_result_hash: cdff39d42765941071c7eb9ce26900d05c0486020e7b96c387b6c7d8abe9a800
      hashes.content_result_hash: 13768c9b5347ba61f0088819c835ee5675278f30436b85a9585255ae462c08fd

  # A splash across a wall, from a shot at a building: an Arclight's shots at
  # the block Crawlers are crossing take the Crawlers on it with the block, in
  # the order the target trees hold them. 158 ticks, the game's hashes.
  - fight.run:
      layout: tests/construction/wall-splash.yaml
      seed: 4242
    expect:
      steps: 158
      hashes.physics_result_hash: feb1225a306cb86afd95cf737b52037cfc6e9e2e0c66ce0fb2de554ea7a0af14
      hashes.content_result_hash: 93124fd978ed648375973cad29fa445e902615c80598eddc674f3ffcbe8d31af

  # The same, with the Arclight turning onto blocks and off them as they enter
  # and leave its line, and re-locking when its splash kills its lock. 161
  # ticks, the game's hashes.
  - fight.run:
      layout: tests/construction/wall-splash-line.yaml
      seed: 4242
    expect:
      steps: 161
      hashes.physics_result_hash: 0ee71021c5d43cfab02d2e4232e26fdce601abe1e44358939959ac09c369846b
      hashes.content_result_hash: 2a16971920806061017481a8694ec3eaa456eac460ae89e85c4b0d8dd9cbfc4b

  # A splash across a wall, from a shot at a unit: the block behind the Crawler
  # it hit, out of the Arclight's reach, takes the shot's full damage. 176
  # ticks, the game's hashes.
  - fight.run:
      layout: tests/construction/wall-splash-behind.yaml
      seed: 4242
    expect:
      steps: 176
      hashes.physics_result_hash: 1a97a4e6d185010d107a5e72970c93b467aaa253cf7185f8358e8e7000907d4a
      hashes.content_result_hash: e80fa9f29003dbeb966fc5803204ae3a3736db58543e68c0697021e4714ea7ef
