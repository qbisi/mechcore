# What does a splash take across a wall?
#
#   mechcore run tests/construction/splash.mcscript --check   parse without the game
#   mechcore run tests/construction/splash.mcscript           record
#
# Everything of the other side within reach: units and buildings alike, in
# both directions, in the order the target trees hold them.
#
#   wall-splash.yaml         Crawlers crossing their wall into an Arclight's
#                            fire; its shots at a block take the Crawlers on it
#   wall-splash-line.yaml    the same, with the Arclight turning onto blocks
#                            and off them as they enter and leave its line
#   wall-splash-behind.yaml  a shot at a Crawler, with a block behind it beyond
#                            the Arclight's reach, takes the block
#
# Each fight is compared with the simulator afterwards, every field of every
# tick.
#
# `out` must not already exist: record_battle refuses to overwrite.

game: launch

vars:
  out: /tmp/mechcore/construction/splash
  seed: 4242

steps:
  - let:
      splash: read_yaml(tests/construction/wall-splash.yaml)
      line: read_yaml(tests/construction/wall-splash-line.yaml)
      behind: read_yaml(tests/construction/wall-splash-behind.yaml)
      cases:
        - {name: splash, layout: tests/construction/wall-splash.yaml}
        - {name: line, layout: tests/construction/wall-splash-line.yaml}
        - {name: behind, layout: tests/construction/wall-splash-behind.yaml}

  # A shot at block 5 at tick 47 takes two Crawlers standing on it and the
  # block, 365, the block's damage event between theirs: 17 of 1112 are left.
  - game.apply_layout:
      layout: $splash
      seed: $seed
  - game.record_battle:
      output: ${out}/splash.mcfr
    expect:
      operation.tick_count: 158
  - fight.buildings:
      recording: ${out}/splash.mcfr
      tick: 47
    expect:
      sides.blue.constructions.0.parts.2.id: 5
      sides.blue.constructions.0.parts.2.life.current: 17

  - game.apply_layout:
      layout: $line
      seed: $seed
  - game.record_battle:
      output: ${out}/line.mcfr
    expect:
      operation.tick_count: 161

  # A shot aimed at Crawler 24 at tick 77 takes block 5 behind it for 365.
  - game.apply_layout:
      layout: $behind
      seed: $seed
  - game.record_battle:
      output: ${out}/behind.mcfr
    expect:
      operation.tick_count: 176
  - fight.buildings:
      recording: ${out}/behind.mcfr
      tick: 77
    expect:
      sides.blue.constructions.0.parts.2.id: 5
      sides.blue.constructions.0.parts.2.life.current: 747

  - foreach: {case: $cases}
    steps:
      - fight.run:
          layout: ${case.layout}
          seed: $seed
          output: ${out}/simulated-${case.name}.mcfr
      - fight.compare:
          left: ${out}/${case.name}.mcfr
          right: ${out}/simulated-${case.name}.mcfr
        expect:
          equal: true
          content_equal: true
