# What does a splash take across a wall?
#
#   mechcore run tests/construction/splash.mcscript --check   parse without the game
#   mechcore run tests/construction/splash.mcscript           record
#
# Everything of the other side within reach: units and buildings alike, in
# both directions, in the order the target trees hold them.
#
#   fights/wall-splash.yaml         Crawlers crossing their wall into an
#                                   Arclight's fire; its shots at a block take
#                                   the Crawlers on it
#   fights/wall-splash-line.yaml    the same, with the Arclight turning onto
#                                   blocks and off them as they enter and
#                                   leave its line
#   fights/wall-splash-behind.yaml  a shot at a Crawler, with a block behind
#                                   it beyond the Arclight's reach, takes the
#                                   block
#
# Each fight is compared with the simulator afterwards, every field of every
# tick.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/construction/splash

steps:
  # A shot at block 5 at tick 47 takes two Crawlers standing on it and the
  # block, 365, the block's damage event between theirs: 17 of 1112 are left.
  - game.record:
      input: tests/construction/fights/wall-splash.yaml
      output: ${out}/splash.mcfr
    expect:
      operation.tick_count: 158
  - show:
      input: ${out}/splash.mcfr
      view: buildings
      tick: 47
    expect:
      sides.blue.constructions.0.parts.2.id: 5
      sides.blue.constructions.0.parts.2.life.current: 17

  - game.record:
      input: tests/construction/fights/wall-splash-line.yaml
      output: ${out}/line.mcfr
    expect:
      operation.tick_count: 161

  # A shot aimed at Crawler 24 at tick 77 takes block 5 behind it for 365.
  - game.record:
      input: tests/construction/fights/wall-splash-behind.yaml
      output: ${out}/behind.mcfr
    expect:
      operation.tick_count: 176
  - show:
      input: ${out}/behind.mcfr
      view: buildings
      tick: 77
    expect:
      sides.blue.constructions.0.parts.2.id: 5
      sides.blue.constructions.0.parts.2.life.current: 747

  - verify:
      input:
        - ${out}/splash.mcfr
        - ${out}/line.mcfr
        - ${out}/behind.mcfr
    expect: {invalid: []}
