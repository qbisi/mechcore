# Does a Defensive Wall stop anything?
#
#   mechcore run tests/construction/wall.mcscript --check   parse without the game
#   mechcore run tests/construction/wall.mcscript           record
#
# `shape.mcscript` settled what a wall is: five objects 12 metres apart, 1112
# of life and an 8 metre box each. What that does not say is whether the box is
# an obstacle. The simulator's buildings are immovable RVO colliders, and a
# wall that is one would push units around; a wall that is not is only a target
# standing in the open.
#
# The wall's own description says it sinks into the ground for a friendly unit,
# which would make it an obstacle for one side and not the other. So both sides
# are asked, with the same unit and the same geometry:
#
#   fights/wall-passage.yaml   blue's own Crawlers cross blue's wall
#   fights/wall-block.yaml     red's Crawlers meet blue's wall on the way in
#
# Each Crawler is 1.5 metres of inner radius against a block's 4, and the gaps
# between blocks are 4 metres wide, so a wall that collides would leave a
# Crawler either threading a gap or stopped — and in neither case closer to a
# block's centre than 5.5 metres.
#
# **Both recordings put a Crawler inside a block**: 0.567 metres from a centre
# at tick 55 of the passage, 0.711 at tick 96 of the block. Neither is
# assertable here, because nothing this reader answers is a distance between
# two objects; what is asserted instead is everything that follows from it, and
# `docs/rules/constructions.md` carries the two numbers with the recordings
# they came from.
#
# What separates the two fights is targeting and not collision. Red's Crawlers
# stop and attack the wall — four blocks down, the fifth at 401 of 1112 — while
# blue's cross their own and leave all five at full life. That is the reading
# the simulator has to reproduce, and the tick-exact check is
# `verify` once `FightConstructionSystem` places one.
#
# `out` must not already exist: a recording refuses to overwrite.

game: launch
headless: true

vars:
  out: /tmp/mechcore/construction/wall

steps:
  # The side that placed it. Twenty-four Crawlers cross the line the wall
  # stands on and not one block loses a point of life.
  - convert:
      to: mcfr
      backend: game
      input: tests/construction/fights/wall-passage.yaml
      output: ${out}/passage.mcfr
    expect:
      operation.tick_count: 341
  - show:
      input: ${out}/passage.mcfr
      view: buildings
      tick: 341
    expect:
      sides.blue.constructions.0.standing: 5
      sides.blue.constructions.0.parts.0.life.current: 1112
      sides.blue.constructions.0.parts.1.life.current: 1112
      sides.blue.constructions.0.parts.2.life.current: 1112
      sides.blue.constructions.0.parts.3.life.current: 1112
      sides.blue.constructions.0.parts.4.life.current: 1112
  - show:
      input: ${out}/passage.mcfr
      view: outcome
    expect:
      # They got through and killed what was on the other side.
      sides.blue.survivors.0.name: crawler
      sides.blue.survivors.0.alive: 19

  # The other side. The same unit against the same wall, and now it is a
  # target: four blocks destroyed and the fifth at 401.
  - convert:
      to: mcfr
      backend: game
      input: tests/construction/fights/wall-block.yaml
      output: ${out}/block.mcfr
    expect:
      operation.tick_count: 209
  - show:
      input: ${out}/block.mcfr
      view: buildings
      tick: 209
    expect:
      sides.blue.constructions.0.standing: 1
      sides.blue.constructions.0.parts.0.life.current: 401
      sides.blue.constructions.0.parts.0.life.maximum: 1112
  - show:
      input: ${out}/block.mcfr
      view: outcome
    expect:
      sides.red.survivors.0.name: crawler
      sides.red.survivors.0.alive: 21

  # Both fights against the simulator, every field of every tick. The side
  # that placed the wall walks through it — the wall is among each Crawler's
  # neighbours and yields it no obstacle — and the side that did not is held
  # by it and takes it down, changing blocks between blows.
  - verify:
      input:
        - ${out}/passage.mcfr
        - ${out}/block.mcfr
    expect: {invalid: []}
